<mxfile host="app.diagrams.net">
  <diagram id="architecture" name="Quantum-safe permissioned ledger">
    <mxGraphModel dx="1600" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="680" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="wallet" value="&lt;b&gt;Wallet / Client&lt;/b&gt;&lt;br&gt;Keys: ML-DSA-65 private and public key&lt;br&gt;Address = SHA-256(public key)&lt;br&gt;Signs transaction {sender, recipient, amount, nonce, timestamp}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#2a78d6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="220" height="150" as="geometry" />
        </mxCell>

        <mxCell id="registry" value="&lt;b&gt;Trusted Registry&lt;/b&gt;&lt;br&gt;Authorised participants' ML-DSA public keys&lt;br&gt;Pinned fingerprint of the validator's ML-KEM public key" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#2a78d6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="360" width="220" height="130" as="geometry" />
        </mxCell>

        <mxCell id="registry_note" value="Proposed: registry entries signed with ML-DSA-87" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d79b00;dashed=1;align=left;spacingLeft=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="520" width="220" height="60" as="geometry" />
        </mxCell>

        <mxCell id="channel" value="&lt;b&gt;Secure Channel (sender side)&lt;/b&gt;&lt;br&gt;1. Check validator KEM fingerprint against the registry&lt;br&gt;2. ML-KEM-768 encapsulation&lt;br&gt;3. HKDF-SHA-256 (bound to the ciphertext hash)&lt;br&gt;4. AES-256-GCM encryption (AAD = ciphertext hash, sender, nonce)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#2a78d6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="100" width="250" height="210" as="geometry" />
        </mxCell>

        <mxCell id="channel_note" value="Proposed: hybrid key exchange (X25519 + ML-KEM-768)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d79b00;dashed=1;align=left;spacingLeft=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="10" width="250" height="60" as="geometry" />
        </mxCell>

        <mxCell id="validator" value="&lt;b&gt;Validator Node&lt;/b&gt;&lt;br&gt;ML-KEM-768 decapsulation, HKDF, AES-GCM decryption (tag check)&lt;br&gt;Verify the ML-DSA-65 signature against the registered key&lt;br&gt;Check the expected nonce and the balance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#2a78d6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="830" y="100" width="250" height="210" as="geometry" />
        </mxCell>

        <mxCell id="ledger" value="&lt;b&gt;Hash-Linked Ledger (SHA-256)&lt;/b&gt;&lt;br&gt;Each block stores the previous block hash&lt;br&gt;Each block is signed by the validator (ML-DSA-65)&lt;br&gt;Balances and nonces are updated" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#2a78d6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1260" y="100" width="250" height="210" as="geometry" />
        </mxCell>

        <mxCell id="ledger_note" value="Proposed: signatures stored as raw bytes; quorum checkpoint (ML-DSA-87) with signature pruning" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d79b00;dashed=1;align=left;spacingLeft=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1260" y="10" width="250" height="70" as="geometry" />
        </mxCell>

        <mxCell id="e_wallet_channel" value="signed transaction" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="wallet" target="channel">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_channel_validator" value="KEM ciphertext + AES-GCM ciphertext (untrusted network)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#c0392b;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="channel" target="validator">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_validator_ledger" value="accepted transaction, signed block" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="validator" target="ledger">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_registry_channel" value="pinned fingerprint" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;fontSize=11;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="registry" target="channel">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_registry_validator" value="registered public keys" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;fontSize=11;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="registry" target="validator">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="955" y="464" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="e_wallet_registry" value="enrol public key" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="wallet" target="registry">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_channel_note" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;dashed=1;strokeColor=#d79b00;" edge="1" parent="1" source="channel_note" target="channel">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_ledger_note" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;dashed=1;strokeColor=#d79b00;" edge="1" parent="1" source="ledger_note" target="ledger">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_registry_note" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;dashed=1;strokeColor=#d79b00;" edge="1" parent="1" source="registry_note" target="registry">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="legend_impl_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#2a78d6;" vertex="1" parent="1">
          <mxGeometry x="400" y="520" width="30" height="20" as="geometry" />
        </mxCell>
        <mxCell id="legend_impl_text" value="Implemented in the Task 5 prototype" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="440" y="515" width="300" height="30" as="geometry" />
        </mxCell>
        <mxCell id="legend_prop_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d79b00;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="560" width="30" height="20" as="geometry" />
        </mxCell>
        <mxCell id="legend_prop_text" value="Proposed extension (not implemented)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="440" y="555" width="300" height="30" as="geometry" />
        </mxCell>
        <mxCell id="legend_net_line" value="" style="endArrow=none;html=1;strokeColor=#c0392b;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="800" y="530" as="sourcePoint" />
            <mxPoint x="830" y="530" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="legend_net_text" value="Untrusted network link (attacker can read, modify, replay)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="840" y="515" width="380" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
